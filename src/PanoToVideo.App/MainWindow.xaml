<Window x:Class="PanoToVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PanoToVideo.App.Controls"
        Title="全景图转短视频" Height="780" Width="1440" MinHeight="720" MinWidth="1120"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="全景图转短视频" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="批量生成竖屏透视镜头视频 · 2:1 全景图输入" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" FontSize="12"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Height="38" Padding="11,0"><Grid VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding DeviceInfo}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" LineHeight="16"/></StackPanel></Grid></Border><Button x:Name="ThemeToggleButton" Content="☀" ToolTip="切换到浅色主题" Click="ToggleTheme_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Width="34" Height="34" Padding="0" FontSize="17" FontFamily="Segoe UI Symbol"/></StackPanel>
        </Grid>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsEnabled="{Binding IsNotExporting}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="导出设置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="先设置常用选项；复杂镜头和性能参数在高级设置中。" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,2,0,9"/>
                    <TextBlock Text="常用设置" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="视频时长（秒）" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding DurationSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" Step="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="旋转方向" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><ComboBox SelectedIndex="{Binding DirectionIndex}"><ComboBoxItem Content="顺时针"/><ComboBoxItem Content="逆时针"/></ComboBox></StackPanel></Grid>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="输出方向" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><ComboBox SelectedIndex="{Binding OutputOrientationIndex, Mode=TwoWay}"><ComboBoxItem Content="横屏"/><ComboBoxItem Content="竖屏"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="输出分辨率" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><ComboBox SelectedIndex="{Binding ResolutionPresetIndex, Mode=TwoWay}"><ComboBoxItem Content="1080P"/><ComboBoxItem Content="2K"/><ComboBoxItem Content="720P"/><ComboBoxItem Content="自定义"/></ComboBox></StackPanel></Grid>
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="视频宽度" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding Width, Mode=TwoWay}" Minimum="2" Maximum="7680" Step="2" AllowTextInput="True" IsEnabled="{Binding IsCustomResolution}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="视频高度" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding Height, Mode=TwoWay}" Minimum="2" Maximum="7680" Step="2" AllowTextInput="True" IsEnabled="{Binding IsCustomResolution}"/></StackPanel></Grid>
                    <TextBlock Text="质量预设" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0"/><ComboBox SelectedIndex="{Binding PresetIndex}"><ComboBoxItem Content="兼容优先 · H.264"/><ComboBoxItem Content="体积优先 · H.265"/></ComboBox>
                    <CheckBox Content="导出完成后打开结果" IsChecked="{Binding OpenAfterExport}" Margin="0,7,0,0"/>

                    <Expander><Expander.Header><TextBlock Text="高级镜头与性能设置" FontSize="11" FontWeight="SemiBold"/></Expander.Header><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="旋转度数" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding RotationDegrees, Mode=TwoWay}" Minimum="1" Maximum="3600" Step="15" AllowTextInput="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FPS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding Fps, Mode=TwoWay}" Minimum="24" Maximum="60" AllowedValues="24,25,30,50,60" AllowTextInput="True"/></StackPanel></Grid>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="水平 FOV" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding HorizontalFovDegrees, Mode=TwoWay}" Minimum="30" Maximum="110" Step="1" AllowTextInput="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="俯仰角" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><controls:NumericStepper Value="{Binding PitchDegrees, Mode=TwoWay}" Minimum="-85" Maximum="85" Step="1" AllowTextInput="True"/></StackPanel></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="起始方位" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><Slider Minimum="0" Maximum="359" Value="{Binding StartYaw, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" TickFrequency="15" IsSnapToTickEnabled="False" Margin="0,3,10,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,4" VerticalAlignment="Bottom"><TextBlock Text="{Binding StartYaw, StringFormat={}{0:F0}°}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/></Border></Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,7,0,0"><StackPanel><CheckBox Content="重点区域慢转" IsChecked="{Binding IsRotationTempoEnabled}" FontWeight="SemiBold"/><TextBlock Text="{Binding RotationTempoSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,5"/><Grid IsEnabled="{Binding IsRotationTempoEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始时间（秒）" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><controls:NumericStepper Value="{Binding SlowRotationStartSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding SlowRotationStartMaximum}" Step="1" AllowTextInput="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="慢转维持（秒）" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><controls:NumericStepper Value="{Binding SlowHoldSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding SlowHoldMaximum}" Step="1" AllowTextInput="True"/></StackPanel></Grid><Grid Margin="0,5,0,0" IsEnabled="{Binding IsRotationTempoEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="平滑过渡（秒）" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><controls:NumericStepper Value="{Binding SlowTransitionSeconds, Mode=TwoWay}" Minimum="1" Maximum="{Binding SlowTransitionMaximum}" Step="1" AllowTextInput="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="慢转速度（%）" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><controls:NumericStepper Value="{Binding SlowSpeedPercent, Mode=TwoWay}" Minimum="10" Maximum="90" Step="5" AllowTextInput="True"/></StackPanel></Grid></StackPanel></Border>
                        <TextBlock Text="CPU 回退核心数" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0"/><controls:NumericStepper Value="{Binding CpuCores, Mode=TwoWay}" Minimum="1" Maximum="{Binding CpuCoreInputMaximum}" Step="1" AllowTextInput="True" IsReadOnly="{Binding IsCpuCoreInputReadOnly}"/><TextBlock Text="{Binding CpuCoresHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,3,0,0"><CheckBox Content="启用小行星开场" IsChecked="{Binding AsteroidIntro}"/><CheckBox Content="记住本次配置" IsChecked="{Binding RememberSettings}"/></WrapPanel>
                    </StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="导出队列" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="添加图片后可继续追加；选中一项可预览或移除。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="{Binding QueueItems.Count, StringFormat={}{0} 项}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/></Border><Button Grid.Column="3" Content="添加图片" Command="{Binding BrowseCommand}" FontSize="10" Padding="7,4" MinWidth="62" IsEnabled="{Binding IsNotExporting}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QueueList}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="5" Content="移除选中" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource QuietButton}" FontSize="10" Padding="7,4" MinWidth="62"/><Button Grid.Column="7" Content="清空队列" Command="{Binding ClearQueueCommand}" Style="{StaticResource QuietButton}" FontSize="10" Padding="7,4" MinWidth="62"/></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><TextBlock Text="文件" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="状态" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><TextBlock Grid.Column="2" Text="进度 / FPS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Right"/></Grid>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="{Binding PreviewPanelWidth}"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="QueueList" ItemsSource="{Binding QueueItems}" SelectedIndex="{Binding SelectedQueueIndex}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemRoot" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Width, StringFormat={}{0} px}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,1,0,0"/><TextBlock Text="{Binding DetailText}" ToolTip="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding ProgressText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Right" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding PreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="{Binding PreviewStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/><Grid Grid.Row="2" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PreviewTimeSeconds, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" TickFrequency="1" Margin="0,0,6,0"/><TextBlock Grid.Column="1" Text="{Binding PreviewTimeLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"><Button Content="{Binding PreviewPlayButtonText}" Command="{Binding TogglePreviewPlaybackCommand}" Style="{StaticResource QuietButton}" FontSize="10" Padding="8,3" MinWidth="42"/><Button Content="↺" ToolTip="回到开头" Command="{Binding ResetPreviewPlaybackCommand}" Style="{StaticResource QuietButton}" FontSize="13" Padding="5,1" Margin="4,0,0,0"/><ComboBox SelectedIndex="{Binding PreviewPlaybackRateIndex}" Width="43" FontSize="9" Margin="4,0,0,0"><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/></ComboBox></StackPanel><TextBlock Grid.Row="4" Text="{Binding PreviewMotionHint}" Foreground="{DynamicResource AccentBrush}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/></Grid></Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="285"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QueueList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="20" HorizontalAlignment="Center"><TextBlock Text="+" Foreground="{DynamicResource AccentBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="从这里开始建立导出队列" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,3"/><TextBlock Text="添加一张或多张 2:1 全景图后，即可开始导出。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/><Button Content="添加图片" Command="{Binding BrowseCommand}" Width="104" HorizontalAlignment="Center" Margin="0,12,0,0" IsEnabled="{Binding IsNotExporting}"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="5" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5" Padding="9" Margin="0,6,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SeamlessHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SeamlessHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/></Border>
                </Grid>
            </Border>

            <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="导出概览" FontSize="16" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,9" FontSize="11"/>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,9"><StackPanel><TextBlock Text="实际导出方式" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><TextBlock Text="{Binding DeviceInfo}" TextWrapping="Wrap" Margin="0,2,0,6" FontSize="12"/><TextBlock Text="{Binding EncoderInfo}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10"><TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="10" LineHeight="16"/></Border>
                    <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="9" Margin="0,9,0,9" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding FallbackHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding FallbackHint}" Foreground="{DynamicResource HintTextBrush}" TextWrapping="Wrap" FontSize="11"/></Border>
                    <StackPanel Grid.Row="5"><Button Content="开始导出" Command="{Binding ExportCommand}" Height="36"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="暂停" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Content="恢复" Command="{Binding ResumeCommand}" Style="{StaticResource SecondaryButton}"/></Grid><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="跳过当前" Command="{Binding CancelCurrentCommand}" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="取消全部" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"/></Grid><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="重试选中" Command="{Binding RetryCommand}" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="重试失败项" Command="{Binding RetryFailedCommand}" Style="{StaticResource QuietButton}"/></Grid></StackPanel>
                </Grid></Border>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="导出目录" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding OutputDir}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDir}" Margin="0,3,0,0" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="选择" Command="{Binding BrowseOutputDirCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="8,5"/><Button Grid.Column="3" Content="打开" Command="{Binding OpenOutputDirCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="8,5"/></Grid></Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="整体导出进度" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding CompletedCount, StringFormat=已完成 {0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" FontSize="11"/><TextBlock Text="{Binding FailedCount, StringFormat=失败 {0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" FontSize="11"/></StackPanel><ProgressBar Grid.Column="1" Value="{Binding TotalProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="18,0,12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding TotalProgressPercent, StringFormat={}{0:F0}%}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/></Grid></Border>
    </Grid>
</Window>
