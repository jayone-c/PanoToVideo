<Window x:Class="PanoToVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全景图转短视频" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶部 -->
            <RowDefinition Height="*"/>       <!-- 中部三列 -->
            <RowDefinition Height="Auto"/>    <!-- 底部 -->
        </Grid.RowDefinitions>

        <!-- 顶部：文件输入 + 输出目录 + 硬件状态 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="选择图片" Command="{Binding BrowseCommand}" Width="80" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectedFilePath, TargetNullValue=未选择}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="输出目录" Command="{Binding BrowseOutputDirCommand}" Width="80" Margin="8,0,8,0"/>
            <TextBlock Grid.Column="3" Text="{Binding OutputDir, TargetNullValue=未选择}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="4" Text="{Binding DeviceInfo}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkBlue"/>
        </Grid>

        <!-- 中部：左参数 + 中队列 + 右详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>   <!-- 左：参数 -->
                <ColumnDefinition Width="*"/>      <!-- 中：队列 -->
                <ColumnDefinition Width="280"/>   <!-- 右：详情 -->
            </Grid.ColumnDefinitions>

            <!-- 左：参数面板 -->
            <GroupBox Grid.Column="0" Header="参数" Margin="0,0,4,0">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="时长(秒)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DurationSeconds}" Margin="4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="旋转度数" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RotationDegrees}" Margin="4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FPS" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Fps}" Margin="4"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="FOV" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HorizontalFov}" Margin="4"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="宽" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Width}" Margin="4"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="高" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Height}" Margin="4"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="俯仰角" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Pitch}" Margin="4"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="预设" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="{Binding PresetIndex}" Margin="4">
                        <ComboBoxItem Content="兼容优先(H.264)"/>
                        <ComboBoxItem Content="体积优先(H.265)"/>
                    </ComboBox>
                    <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="小行星开场" IsChecked="{Binding AsteroidIntro}" Margin="4"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SeamlessHint}" Foreground="Orange" TextWrapping="Wrap" Margin="4" Visibility="Collapsed"/>
                </Grid>
            </GroupBox>

            <!-- 中：队列列表 -->
            <GroupBox Grid.Column="1" Header="队列" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding QueueItems}" SelectedIndex="{Binding SelectedQueueIndex}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding SourceFileName}" Width="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Width="80" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding SeamlessHint}" Foreground="Orange" TextWrapping="Wrap" Margin="4"/>
                </Grid>
            </GroupBox>

            <!-- 右：详情/进度/设备 -->
            <GroupBox Grid.Column="2" Header="详情" Margin="4,0,0,0">
                <StackPanel Margin="4">
                    <TextBlock Text="当前任务" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="20" Margin="0,4"/>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding PresetFallbackHint}" Foreground="Orange" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="设备" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding DeviceInfo}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EncoderInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="开始导出" Command="{Binding ExportCommand}" Width="80" Height="32" Margin="0,0,8,0"/>
                        <Button Content="取消" Command="{Binding CancelCommand}" Width="60" Height="32" Margin="0,0,8,0"/>
                        <Button Content="重试" Command="{Binding RetryCommand}" Width="60" Height="32"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 底部：累计 + 总进度 + 打开目录 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CompletedCount, StringFormat=完成:{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding FailedCount, StringFormat=失败:{0}}" Margin="0,0,16,0"/>
                <ProgressBar Value="{Binding TotalProgressPercent}" Maximum="100" Width="300" Height="16"/>
                <TextBlock Text="{Binding TotalProgressPercent, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="打开输出目录" Command="{Binding OpenOutputDirCommand}" Width="110" Height="28"/>
        </Grid>
    </Grid>
</Window>
