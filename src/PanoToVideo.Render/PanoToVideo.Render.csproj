<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PanoToVideo.Core\PanoToVideo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- shader 源码作为 Content 复制到输出目录 Shaders/，运行时用 Vortice.D3DCompiler 编译 -->
  <!-- 注：原计划 fxc 预编译嵌入 .cso（规划§1.1），但 MSBuild 动态 EmbeddedResource 时序问题
       导致无法可靠嵌入。改用运行时编译，等价且无外部依赖。该调整记入 ADR 0001。 -->
  <ItemGroup>
    <None Include="D3D11\Shaders\*.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
