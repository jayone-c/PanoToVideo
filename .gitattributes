# 文本文件统一按文本处理；源码保留 Windows 开发环境常用的 CRLF，文档使用 LF。
* text=auto

*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.xaml   text eol=crlf
*.hlsl   text eol=crlf

*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.gitignore text eol=lf

# 二进制资源不得做换行或编码转换。
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.dll binary
*.exe binary
